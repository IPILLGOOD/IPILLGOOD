GOOGLE_CLOUD_PROJECT=care-atlas-seoul-2026-v2
FIREBASE_PROJECT_ID=care-atlas-seoul-2026-v2
# IAM 권한이 필요 없는 기본 로컬 경로는 이 파일을 수정하지 않고 `npm run dev:local`로 실행합니다.
# 스크립트가 demo 프로젝트와 loopback Auth·Firestore Emulator 설정을 주입합니다.
# 로컬 데모 로그인에는 반드시 true로 설정합니다. 변경 후 개발 서버를 다시 시작하세요.
IPILLGOOD_DEMO_MODE=true
# 운영 공개 데모는 isolated 모드와 정확한 허용 호스트가 함께 설정된 경우에만 활성화됩니다.
IPILLGOOD_PUBLIC_DEMO_MODE=isolated
IPILLGOOD_DEMO_ALLOWED_HOSTS=ipillgood.wkddudgk4869.workers.dev

# staging에서 CSP 위반을 먼저 확인할 때만 report-only로 설정합니다. 운영 기본값은 enforce입니다.
CSP_MODE=enforce

# 로그인 세션 (Google 로그인은 Firebase Authentication V2 사용)
# 데모 로그인도 항상 강한 세션 비밀키가 필요합니다.
# SESSION_SECRET 생성 예시: openssl rand -base64 32
SESSION_SECRET=

# 일회용 공동 사용 연결 코드를 HMAC 처리하는 32바이트 이상의 별도 비밀값
CONNECTION_CODE_SECRET=

# Web Push (Chrome/Edge/Firefox/Safari 공통, 서버 전용 비공개키 포함)
# 키 생성: npm run push:keys --workspace @care-atlas/front
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Cloudflare Cron이 내부 발송 API를 호출할 때 사용하는 32자 이상의 서버 전용 비밀값
PUSH_CRON_SECRET=

# 운영자가 로그인 세션 없이 특정 등록 기기의 테스트 Push를 검증할 때 사용하는 서버 전용 비밀값
PUSH_OPERATOR_SECRET=

# 외부 문서 분석 API 서버 전용 설정
AI_ANALYSIS_ENDPOINT=
AI_API_KEY=

# OpenAI Responses API: 문서 분석, 질병 검색, 약물 쉬운 설명 (서버 전용)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# 건강보험심사평가원 질병정보서비스 Open API (서버 전용)
HIRA_DISEASE_API_URL=https://apis.data.go.kr/B551182/diseaseInfoService
HIRA_DISEASE_API_KEY=

# 식품의약품안전처 의약품 제품 허가정보·e약은요·약물 유전 정보 Open API (서버 전용)
MFDS_PRODUCT_API_URL=https://apis.data.go.kr/1471000/DrugPrdtPrmsnInfoService07
MFDS_EASY_DRUG_API_URL=https://apis.data.go.kr/1471000/DrbEasyDrugInfoService
MFDS_PARMGEN_API_URL=https://apis.data.go.kr/1471000/ParmgenService
MFDS_MEDICATION_API_KEY=
# 약물 유전 정보가 별도 프로젝트 키로 승인된 경우에만 설정
MFDS_PARMGEN_API_KEY=
# #99: Three-month soft deletion/recovery policy is versioned in code. See docs/account-deletion.md.
