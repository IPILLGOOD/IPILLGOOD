{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipillgood",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna",
    "IPILLGOOD_DEMO_MODE": "true",
    "IPILLGOOD_PUBLIC_DEMO_MODE": "isolated",
    "IPILLGOOD_DEMO_ALLOWED_HOSTS": "ipillgood.wkddudgk4869.workers.dev",
    "MFDS_PARMGEN_API_URL": "https://apis.data.go.kr/1471000/ParmgenService",
    "HIRA_DISEASE_API_URL": "https://apis.data.go.kr/B551182/diseaseInfoService"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT_AUTH",
      "namespace_id": "5801",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_ANALYSIS",
      "namespace_id": "5802",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_SEARCH",
      "namespace_id": "5803",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_CHECKIN",
      "namespace_id": "5804",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ipillgood"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
