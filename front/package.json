{
  "name": "@care-atlas/front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload -- --keep-vars",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "qa:functional": "node scripts/functional-qa.mjs",
    "qa:google-pwa": "node scripts/google-auth-pwa-qa.mjs",
    "qa:demo-isolation": "node --experimental-strip-types scripts/demo-isolation-qa.mjs",
    "qa:push": "node scripts/push-qa.mjs",
    "qa:security-headers": "node scripts/security-headers-qa.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@care-atlas/backend": "*",
    "@mmmike/web-push": "^1.3.0",
    "firebase": "^12.17.1",
    "jose": "^6.2.9",
    "lottie-web": "5.13.0",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.11.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.1",
    "typescript": "6.0.2",
    "wrangler": "^4.123.0"
  }
}
